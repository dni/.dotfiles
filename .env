#!/usr/bin/env sh
export SCRIPTS=~/scripts
export DOTFILES=~/.dotfiles
export ENV=~/.myprofile # this variable is used by sh in an interactive shell
export PATH=$PATH:$SCRIPTS/bin:~/.local/bin:/usr/local/bin

export EDITOR="nvim"
export GTK_THEME=Adwaita:dark

# adb fastboot
if [ -d "$HOME/adb-fastboot/platform-tools" ] ; then
 export PATH="$HOME/adb-fastboot/platform-tools:$PATH"
fi

# java8 is required for jmeter
export LD_LIBRARY_PATH="/lib:/usr/lib:/usr/local/lib:/usr/lib/jvm/java-8-openjdk/jre/lib/amd64/server"
export _JAVA_AWT_WM_NONREPARENTING=1 # fix java swing apps
